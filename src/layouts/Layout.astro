---
interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: string;
}

const { 
  title, 
  description = " - Enablement Engineer and Systems Thinker dedicated to democratizing technology and empowering people through accessible AI solutions.",
  image = "/me-square.jpg",
  ogType = "website"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://dylanisa.ac/");
const ogImageURL = new URL(image, Astro.site || "https://dylanisa.ac/");

const jsonLD = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Dylan Isaac",
  "jobTitle": "Lead AI Engineer",
  "worksFor": {
    "@type": "Organization",
    "name": "Deque Systems",
    "url": "https://deque.com"
  },
  "url": canonicalURL.toString(),
  "sameAs": [
    "https://github.com/dylansheffer",
    "https://www.linkedin.com/in/dylan--isaac/"
  ],
  "description": description,
  "image": ogImageURL.toString()
};
---

<!doctype html>
<html lang="en" class="scroll-smooth" data-theme>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Favicon for various sizes -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon_32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon_48x48.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon_64x64.png" />
    
    <!-- Apple Touch Icons -->
    <link rel="apple-touch-icon" sizes="152x152" href="/favicon_152x152.png" />
    <link rel="apple-touch-icon" sizes="144x144" href="/favicon_144x144.png" />
    <link rel="apple-touch-icon" sizes="72x72" href="/favicon_72x72.png" />
    
    <!-- Android/Chrome Icons -->
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon_192x192.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon_96x96.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="stylesheet" href="/fonts/glacial-indifference.css">
    <link rel="preload" as="image" href="/me-square.jpg" imagesrcset="/me-square.jpg" imagesizes="(min-width: 768px) 10rem, 8rem">
    <meta name="theme-color" content="#eab308" />
    <meta name="generator" content={Astro.generator} />
    
    <style is:inline>
      ::selection {
        background-color: rgba(236, 72, 153, 0.3) !important;
        color: inherit !important;
      }
      ::-moz-selection {
        background-color: rgba(236, 72, 153, 0.3) !important;
        color: inherit !important;
      }
    </style>
    
    <!-- SEO -->
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="Dylan Isaac - Writing" href="/rss.xml" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:image:alt" content="Dylan Isaac - Enablement Engineer" />
    <meta property="og:site_name" content="Dylan Isaac" />
    <meta property="og:locale" content="en_US" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />
    
    <!-- Additional SEO -->
    <meta name="author" content="Dylan Isaac" />
    <meta name="robots" content="index, follow" />
    <meta name="keywords" content="Dylan Isaac, Enablement Engineer, Systems Thinker, Accessibility, AI, Deque Systems, axe Assistant" />
    
    <!-- Structured Data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLD)} />
    
    <script is:inline>
      // Initialize theme immediately to prevent flash
      (function() {
        const theme = localStorage.getItem('theme') || 
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        }
        document.documentElement.setAttribute('data-theme', theme);
        
        // Theme initialization complete
        // Skip link focus management is handled in Header component
      })();
    </script>
  </head>
  <body class="min-h-screen bg-surface dark:bg-dark-surface text-content dark:text-dark-content transition-[background-color,color] duration-200">
    <slot />
  </body>
</html>