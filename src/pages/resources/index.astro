---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Heading from '../../components/Heading.astro';
import Tag from '../../components/Tag.astro';
import { getCollection } from 'astro:content';
import { getTagColorIndex } from '../../utils/tags';

const resources = await getCollection('resources');
const definitions = await getCollection('definitions');
const sortedResources = resources.sort((a, b) => {
  // Featured items first
  if (a.data.featured !== b.data.featured) {
    return b.data.featured ? 1 : -1;
  }
  // Then alphabetical
  return a.data.title.localeCompare(b.data.title);
});

// Group by type
const groupedResources = sortedResources.reduce((acc, resource) => {
  const { type } = resource.data;
  if (!acc[type]) acc[type] = [];
  acc[type].push(resource);
  return acc;
}, {} as Record<string, typeof resources>);

const typeLabels = {
  'ladder': 'Ladders',
  'prompt': 'Prompts',
  'script': 'Scripts',
  'pattern': 'Patterns',
  'tool': 'Tools',
  'guide': 'Guides'
};

const typeDescriptions = {
  'ladder': 'Bridges between human intention and computational power',
  'prompt': 'AI prompts that encode expert knowledge for specific tasks',
  'script': 'Code that extends capabilities and automates complex processes',
  'pattern': 'Reusable approaches that bridge different ways of understanding',
  'tool': 'Utilities and applications that enhance productivity',
  'guide': 'Step-by-step instructions and educational content'
};
---

<Layout title="Resources | Dylan Isaac">
  <Header />
  <main id="main" class="max-w-content-wide mx-auto px-6 md:px-8 py-16" tabindex="-1">
    <div class="max-w-content">
      <Heading level={1} class="text-h1 font-bold mb-4">Resources</Heading>
      
      <div class="prose prose-lg max-w-none mb-16">
        <p class="text-xl text-content-muted dark:text-dark-content-muted">
          Prompts, scripts, and patterns that give people new capabilities. 
          These are bridges between human intention and computational power—tools 
          that adapt to how you think rather than forcing you to adapt to them.
        </p>
        <p class="text-content-muted dark:text-dark-content-muted">
          Learn more about the philosophy behind ladders in 
          <a href="/writing/building-ladders-extending-human-agency-with-ai" class="text-primary-dark dark:text-primary-light hover:text-primary">
            "Building Ladders: Extending Human Agency with AI"
          </a>.
        </p>
      </div>

      {/* Definitions Section */}
      <section class="mb-16 p-8 bg-surface dark:bg-dark-surface rounded-xl border border-content-subtle/30 dark:border-dark-content-subtle/30 hover:border-accent-yellow hover:shadow-lg dark:hover:shadow-2xl focus-within:border-accent-yellow transition-[background-color,border-color,box-shadow] duration-200" aria-labelledby="definitions-section-heading">
        <div>
          <div class="mb-6">
            <Heading level={2} class="text-h2 font-serif font-bold mb-2 text-primary-dark dark:text-primary-light" id="definitions-section-heading">
              Definitions
            </Heading>
            <p class="text-content-muted dark:text-dark-content-muted font-serif italic">
              {definitions.length} terms that establish a shared vocabulary
            </p>
          </div>
          
          <div class="flex flex-wrap gap-3 mb-6" aria-label="Available definitions">
            {definitions.map(def => (
              <a 
                href={`/definitions/${def.slug}`}
                class="font-serif text-content-muted dark:text-dark-content-muted hover:text-primary-dark dark:hover:text-primary-light transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 rounded px-2 py-1 hover:bg-surface-secondary dark:hover:bg-dark-surface-secondary"
              >
                {def.data.term}
              </a>
            )).reduce((prev, curr, index) => {
              const result = [...prev];
              if (index > 0) {
                result.push(<span class="text-content-subtle font-sans" aria-hidden="true">•</span>);
              }
              result.push(curr);
              return result;
            }, [])}
          </div>
          
          <a 
            href="/definitions" 
            class="inline-flex items-center gap-2 text-primary-dark dark:text-primary-light hover:text-primary font-medium focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 rounded"
          >
            Browse Full Glossary
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>

      <div class="space-y-16">
        {Object.entries(groupedResources).map(([type, items]) => (
          <section aria-labelledby={`${type}-section-heading`}>
            <div class="mb-8">
              <Heading level={2} class="text-h2 font-bold mb-2" id={`${type}-section-heading`}>
                {type === 'ladder' ? (
                  <a href="/definitions/ladders" class="hover:text-primary dark:hover:text-primary-light transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 rounded">
                    {typeLabels[type as keyof typeof typeLabels]}
                  </a>
                ) : (
                  typeLabels[type as keyof typeof typeLabels]
                )}
              </Heading>
              <p class="text-content-muted dark:text-dark-content-muted">
                {typeDescriptions[type as keyof typeof typeDescriptions]}
              </p>
            </div>
            
            <div class={`grid gap-8 ${items.length > 1 ? 'md:grid-cols-2' : ''}`}>
              {items.map(resource => (
                <article class="group bg-surface dark:bg-dark-surface rounded-xl p-4 sm:p-6 border border-content-subtle/30 dark:border-dark-content-subtle/30 hover:border-accent-yellow hover:shadow-lg dark:hover:shadow-2xl focus-within:border-primary focus-within:ring-2 focus-within:ring-primary/20 transition-[background-color,border-color,box-shadow] duration-200">
                  <a 
                    href={`/resources/${resource.slug}`}
                    class="block space-y-4 no-underline-link focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 rounded-xl"
                    aria-labelledby={`resource-${resource.slug}-title`}
                  >
                    {resource.data.featured && (
                      <span class="inline-block px-2 py-1 text-small bg-accent-yellow text-content rounded">
                        Featured
                      </span>
                    )}
                    
                    <Heading level={3} class="text-h3 font-bold group-hover:text-primary dark:group-hover:text-primary-light transition-colors" id={`resource-${resource.slug}-title`}>
                      {resource.data.title}
                    </Heading>
                    
                    <p class="text-content-muted dark:text-dark-content-muted">
                      {resource.data.description}
                    </p>
                    
                    <div class="space-y-4">
                      <div>
                        <Heading level={4} class="text-small font-bold text-content-subtle dark:text-dark-content-subtle uppercase tracking-wider mb-2" id={`capabilities-${resource.slug}`}>
                          Capabilities
                        </Heading>
                        <ul class="list-disc list-inside text-small text-content-muted dark:text-dark-content-muted space-y-1" aria-labelledby={`capabilities-${resource.slug}`}>
                          {resource.data.capabilities?.slice(0, 3).map(capability => (
                            <li>{capability}</li>
                          ))}
                          {resource.data.capabilities && resource.data.capabilities.length > 3 && (
                            <li class="text-content-subtle dark:text-dark-content-subtle">
                              +{resource.data.capabilities.length - 3} more...
                            </li>
                          )}
                        </ul>
                      </div>
                      
                      <div class="flex flex-wrap gap-2" aria-label="Resource tags">
                        {resource.data.tags.slice(0, 4).map((tag) => (
                          <Tag name={tag} colorIndex={getTagColorIndex(tag)} />
                        ))}
                      </div>
                    </div>
                  </a>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </main>
</Layout>

<style>
  .no-underline-link {
    text-decoration: none !important;
  }
</style>