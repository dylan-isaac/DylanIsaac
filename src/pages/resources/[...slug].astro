---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Heading from '../../components/Heading.astro';
import Tag from '../../components/Tag.astro';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const resources = await getCollection('resources');
  return resources.map((resource) => ({
    params: { slug: resource.slug },
    props: { resource }
  }));
}) satisfies GetStaticPaths;

const { resource } = Astro.props;
const { Content } = await resource.render();

const typeLabel = {
  'ladder': 'Ladder',
  'prompt': 'Prompt',
  'script': 'Script',
  'pattern': 'Pattern',
  'tool': 'Tool',
  'guide': 'Guide'
}[resource.data.type];
---

<Layout title={`${resource.data.title} | Resources | Dylan Isaac`}>
  <Header />
  <main id="main" class="max-w-content-wide mx-auto px-6 md:px-8 py-16">
    <article class="max-w-content mx-auto">
      <header class="mb-12">
        <div class="flex items-center gap-3 mb-4">
          <a 
            href="/resources" 
            class="text-content-muted hover:text-primary dark:hover:text-primary-light transition-colors"
          >
            ← Back to Resources
          </a>
          <span class="text-content-subtle">•</span>
          <span class="text-small px-2 py-1 bg-surface-muted dark:bg-dark-surface-muted rounded">
            {typeLabel}
          </span>
          {resource.data.featured && (
            <>
              <span class="text-content-subtle">•</span>
              <span class="text-small px-2 py-1 bg-accent-yellow text-content rounded">
                Featured
              </span>
            </>
          )}
        </div>
        
        <Heading level={1} class="text-h1 font-bold mb-4">
          {resource.data.title}
        </Heading>
        
        <p class="text-xl text-content-muted dark:text-dark-content-muted mb-6">
          {resource.data.description}
        </p>
        
        {resource.data.usage && (
          <div class="p-4 bg-surface-secondary dark:bg-dark-surface-secondary rounded-lg mb-6">
            <h2 class="text-small font-bold text-content-subtle dark:text-dark-content-subtle uppercase tracking-wider mb-2">
              Usage
            </h2>
            <p class="text-content dark:text-dark-content">
              {resource.data.usage}
            </p>
          </div>
        )}
        
        {resource.data.capabilities && resource.data.capabilities.length > 0 && (
          <div class="mb-6">
            <h2 class="text-small font-bold text-content-subtle dark:text-dark-content-subtle uppercase tracking-wider mb-3">
              Capabilities
            </h2>
            <ul class="space-y-2">
              {resource.data.capabilities.map(capability => (
                <li class="flex items-start">
                  <span class="text-content-muted dark:text-dark-content-muted mr-2 mt-1">•</span>
                  <span class="text-content dark:text-dark-content">{capability}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
        
        <div class="flex flex-wrap gap-2">
          {resource.data.tags.map((tag, index) => (
            <Tag name={tag} colorIndex={index} />
          ))}
        </div>
      </header>
      
      <div class="prose prose-lg max-w-none
        prose-headings:text-content dark:prose-headings:text-dark-content
        prose-p:text-content dark:prose-p:text-dark-content
        prose-li:text-content dark:prose-li:text-dark-content
        prose-strong:text-content dark:prose-strong:text-dark-content
        prose-code:text-primary-dark dark:prose-code:text-primary-light
        prose-pre:bg-surface-muted dark:prose-pre:bg-dark-surface-muted
        prose-blockquote:text-content-muted dark:prose-blockquote:text-dark-content-muted
        prose-blockquote:border-primary dark:prose-blockquote:border-primary-light
      ">
        <Content />
      </div>
    </article>
  </main>
</Layout>

<style>
  /* Enhance code blocks for better readability */
  :global(.prose pre) {
    border: 1px solid var(--color-surface-muted);
    overflow-x: auto;
  }
  
  :global(.dark .prose pre) {
    border-color: var(--color-dark-surface-muted);
  }
  
  :global(.prose code) {
    font-size: 0.875em;
  }
  
  /* Make inline code stand out */
  :global(.prose :not(pre) > code) {
    background: var(--color-surface-secondary);
    padding: 0.125rem 0.25rem;
    border-radius: 0.25rem;
    font-weight: 500;
  }
  
  :global(.dark .prose :not(pre) > code) {
    background: var(--color-dark-surface-secondary);
  }
</style>