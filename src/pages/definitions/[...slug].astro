---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Heading from '../../components/Heading.astro';
import Tag from '../../components/Tag.astro';
import { getTagColorIndex } from '../../utils/tags';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const definitions = await getCollection('definitions');
  return definitions.map((definition) => ({
    params: { slug: definition.slug },
    props: { definition }
  }));
}) satisfies GetStaticPaths;

const { definition } = Astro.props;
const { Content } = await definition.render();

// Get related definitions
const allDefinitions = await getCollection('definitions');
const relatedDefinitions = definition.data.relatedTerms.length > 0 
  ? allDefinitions.filter(def => 
      definition.data.relatedTerms.includes(def.data.term)
    )
  : [];
---

<Layout title={`${definition.data.term} | Definitions | Dylan Isaac`}>
  <Header />
  <main id="main" class="max-w-content mx-auto px-6 md:px-8 py-16" tabindex="-1">
    <article>
      <header class="mb-12">
        <div class="flex items-center gap-3 mb-6">
          <a 
            href="/definitions" 
            class="text-content-muted hover:text-primary dark:hover:text-primary-light transition-colors"
          >
            ← Back to Definitions
          </a>
        </div>
        
        <Heading level={1} class="text-h1 font-bold mb-6">
          {definition.data.term}
        </Heading>
        
        <div class="text-xl text-content-muted mb-8 p-6 bg-surface-secondary dark:bg-dark-surface-secondary rounded-lg border-l-4 border-primary">
          {definition.data.definition}
        </div>
        
        {definition.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-8">
            {definition.data.tags.map((tag) => (
              <Tag name={tag} colorIndex={getTagColorIndex(tag)} />
            ))}
          </div>
        )}
      </header>
      
      <div class="prose prose-lg max-w-none mb-12
        prose-headings:text-content dark:prose-headings:text-dark-content
        prose-p:text-content dark:prose-p:text-dark-content
        prose-li:text-content dark:prose-li:text-dark-content
        prose-strong:text-content dark:prose-strong:text-dark-content
        prose-a:text-primary-dark dark:prose-a:text-primary-light
        prose-blockquote:text-content-muted dark:prose-blockquote:text-dark-content-muted
        prose-blockquote:border-primary dark:prose-blockquote:border-primary-light
      ">
        <Content />
      </div>
      
      {relatedDefinitions.length > 0 && (
        <section class="mt-20 pt-12 border-t border-surface-muted dark:border-dark-surface-muted">
          <Heading level={2} class="text-h2 font-bold mb-6">
            Related Terms
          </Heading>
          
          <div class="space-y-6">
            {relatedDefinitions.map(related => (
              <a 
                href={`/definitions/${related.slug}`}
                class="block p-4 bg-surface-secondary dark:bg-dark-surface-secondary rounded-lg hover:bg-surface-muted dark:hover:bg-dark-surface-muted transition-colors duration-200 no-underline-link"
              >
                <h3 class="text-h4 font-bold mb-2 text-primary dark:text-primary-light">
                  {related.data.term}
                </h3>
                <p class="text-content-muted">
                  {related.data.definition}
                </p>
              </a>
            ))}
          </div>
        </section>
      )}
    </article>
  </main>
</Layout>

<style>
  .no-underline-link {
    text-decoration: none !important;
  }
</style>