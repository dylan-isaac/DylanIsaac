---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Tag from '../../components/Tag.astro';
import Heading from '../../components/Heading.astro';
import ArrowLink from '../../components/ArrowLink.astro';
import { getCollection } from 'astro:content';
import { format } from 'date-fns';
import { getTagColorIndex } from '../../utils/tags';

const posts = await getCollection('writing');
const isDevelopment = import.meta.env.DEV;
const filteredPosts = posts.filter(post => isDevelopment || !post.data.draft);
const sortedPosts = filteredPosts.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

// Function to estimate reading time
function getReadingTime(content: string) {
  const wordsPerMinute = 200;
  const words = content.split(/\s+/).length;
  const minutes = Math.ceil(words / wordsPerMinute);
  return `${minutes} min read`;
}


// Get type icon
function getTypeIcon(type: string) {
  const icons = {
    'article': '📝',
    'note': '📌',
    'tutorial': '🎓'
  };
  return icons[type as keyof typeof icons] || '📄';
}
---

<Layout 
  title="Writing | Dylan Isaac"
  description="Thoughts on accessibility, AI, systems thinking, and building technology that empowers people. Articles and notes by Dylan Isaac."
>
  <Header />
  <main id="main" class="max-w-content-wide mx-auto px-6 md:px-8 py-16" tabindex="-1">
    <div class="max-w-content">
      <div class="mb-16">
        <div class="flex items-start justify-between mb-4">
          <div>
            <Heading level={1} class="text-h1 font-bold mb-3">Writing</Heading>
            <p class="text-xl text-content-muted dark:text-dark-content-muted">
              Thoughts on accessibility, AI, and building technology that empowers people. For clarity on specialized terms, see the <a href="/definitions" class="text-primary dark:text-primary-light hover:underline focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 rounded-sm">definitions</a>.
            </p>
          </div>
          <a href="/rss.xml" class="inline-flex items-center gap-2 px-3 py-1 text-small bg-surface dark:bg-dark-surface rounded-full hover:bg-accent-yellow/10 transition-colors" aria-label="RSS Feed">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <circle cx="6" cy="18" r="2.5"/>
              <path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z"/>
            </svg>
            RSS
          </a>
        </div>
        
        <!-- Stats Bar -->
        <div class="flex gap-6 text-small text-content-subtle dark:text-dark-content-subtle mt-8">
          <span>{sortedPosts.length} articles</span>
          <span>•</span>
          <span>{new Set(sortedPosts.flatMap(p => p.data.tags || [])).size} topics</span>
          <span>•</span>
          <span>Since {format(sortedPosts[sortedPosts.length - 1]?.data.publishDate || new Date(), 'yyyy')}</span>
        </div>
      </div>
      
      <section id="recent-posts" aria-labelledby="recent-posts-heading">
        <Heading level={2} class="sr-only" id="recent-posts-heading">Recent Posts</Heading>
        <div class="space-y-8" role="feed" aria-label="Recent blog posts">
          {sortedPosts.map(async (post, index) => {
            const { Content } = await post.render();
            const readingTime = getReadingTime(post.body || '');
            const typeIcon = getTypeIcon(post.data.type || 'article');
            
            return (
              <article 
                class="article-card group relative bg-surface dark:bg-dark-surface rounded-xl border border-content-subtle/30 dark:border-dark-content-subtle/30 hover:border-accent-yellow hover:shadow-lg dark:hover:shadow-2xl focus-within:border-primary focus-within:ring-2 focus-within:ring-primary/20 focus-within:shadow-lg transition-[background-color,border-color,box-shadow] duration-200"
                aria-labelledby={`post-title-${index}`}
                aria-describedby={`post-meta-${index} ${post.data.description ? `post-desc-${index}` : ''}`}
              >
                <div class="p-4 sm:p-6 md:p-8">
                  <!-- Article Header -->
                  <div class="flex items-start justify-between mb-4">
                    <div class="flex items-center gap-3">
                      <span class="text-2xl" role="img" aria-label={`${post.data.type || 'article'} type`}>
                        {typeIcon}
                      </span>
                      <div id={`post-meta-${index}`} class="flex items-center gap-3 text-small text-content-muted dark:text-dark-content-muted">
                        <time datetime={post.data.publishDate.toISOString()} aria-label={`Published ${format(post.data.publishDate, 'MMMM d, yyyy')}`}>
                          {format(post.data.publishDate, 'MMMM d, yyyy')}
                        </time>
                        <span aria-hidden="true">•</span>
                        <span aria-label={`Estimated reading time: ${readingTime}`}>{readingTime}</span>
                      </div>
                    </div>
                    {post.data.draft && (
                      <span class="px-2 py-1 text-xs bg-accent-yellow text-content rounded" aria-label="Draft post">
                        Draft
                      </span>
                    )}
                  </div>
                  
                  <!-- Article Content -->
                  <div class="space-y-4">
                    <Heading level={3} class="text-h2 font-bold group-hover:text-primary dark:group-hover:text-primary-light transition-colors" id={`post-title-${index}`}>
                      <a 
                        href={`/writing/${post.slug}`} 
                        class="focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-surface dark:focus:ring-offset-dark-surface rounded-md"
                        aria-describedby={`post-meta-${index} ${post.data.description ? `post-desc-${index}` : ''}`}
                      >
                        {post.data.title}
                      </a>
                    </Heading>
                    {post.data.description && (
                      <p id={`post-desc-${index}`} class="text-content-muted dark:text-dark-content-muted leading-relaxed">
                        {post.data.description}
                      </p>
                    )}
                  </div>

                  
                  <!-- Hover Indicator -->
                  <div class="absolute bottom-0 left-0 right-0 h-1 bg-accent-yellow transform scale-x-0 group-hover:scale-x-100 group-focus-within:scale-x-100 transition-transform duration-200" aria-hidden="true"></div>
                </div>
                <!-- Tags outside of link -->
                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-2 px-8 pb-8 -mt-2" aria-label="Article tags">
                    {post.data.tags.map((tag) => (
                      <Tag name={tag} colorIndex={getTagColorIndex(tag)} />
                    ))}
                  </div>
                )}
              </article>
            );
          })}
        </div>
      </section>
    </div>
  </main>
</Layout>

