---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Card from '../components/Card.astro';
import Heading from '../components/Heading.astro';
import DecorativeEmoji from '../components/DecorativeEmoji.astro';

const contentAreas = [
  {
    title: "Writing",
    body: "Thoughts on AI, accessibility, and human-centered technology",
    href: "/writing"
  },
  {
    title: "Projects", 
    body: "Tools and systems built to empower people and teams",
    href: "/projects"
  },
  {
    title: "Resources",
    body: "Curated collection of useful tools, articles, and references",
    href: "/resources"
  },
  {
    title: "About",
    body: "More details about my background, experience, and approach",
    href: "/about"
  }
];
---

<Layout 
  title="Dylan Isaac - Enablement Engineer & Systems Thinker"
  description="AI engineer focused on building accessible technology that adapts to human needs. Explore my writing, projects, and resources on human-centered tech."
>
  <Header />
  <main id="main" class="max-w-4xl mx-auto px-6 md:px-8 py-16 space-y-16" tabindex="-1">
    <!-- Hero Section -->
    <section class="text-center space-y-8" aria-labelledby="hero-heading">
      <div class="space-y-4">
        <figure class="mb-6">
          <picture>
            <source srcset="/me-square.jpg" type="image/jpeg" />
            <img
              src="/me-square.jpg"
              alt="Dylan Isaac"
              class="w-32 h-32 md:w-40 md:h-40 rounded-full mx-auto object-cover border-4 border-accent-yellow dark:border-accent-yellow"
              width="160"
              height="160"
              loading="eager"
              decoding="async"
              fetchpriority="high"
              sizes="(min-width: 768px) 10rem, 8rem"
            />
          </picture>
        </figure>
        
        <Heading level={1} class="text-h1 font-bold">
          Dylan Isaac
        </Heading>
        
        <p class="text-h3 text-content-muted dark:text-dark-content-muted font-medium">
          Enablement Engineer & Systems Thinker
        </p>
        
        <p class="text-xl font-bold mb-4 text-content dark:text-dark-content">
          For decades, we've forced humans to adapt to computers.<br/>
          I'm reversing that.
        </p>
        
        <p class="text-lg leading-relaxed max-w-2xl mx-auto text-content-muted dark:text-dark-content-muted">
          I <a href="/definitions/building-ladders" class="text-primary-dark dark:text-primary-light hover:text-primary font-medium underline underline-offset-4">build ladders</a>—technology 
          that meets you where you are and helps you climb to expertise previously out of reach. 
          No forced adaptation. No prerequisite knowledge. Just tools that speak your language.
        </p>
      </div>
    </section>

    <!-- Core Beliefs Section -->
    <section class="py-12 border-y border-surface-muted dark:border-dark-surface-muted" aria-labelledby="philosophy-heading">
      <div class="max-w-4xl mx-auto">
        <Heading level={2} class="text-h3 font-bold text-content dark:text-dark-content text-center mb-8" id="philosophy-heading">
          Core Beliefs
        </Heading>
        
        <div class="grid md:grid-cols-2 gap-x-8 gap-y-6">
          <div class="flex gap-4 min-h-[4.5rem]">
            <DecorativeEmoji emoji="🧭" class="text-2xl flex-shrink-0" />
            <div class="flex-1">
              <p class="font-semibold text-content dark:text-dark-content mb-1">Adaptive Technology</p>
              <p class="text-content-muted dark:text-dark-content-muted">Technology should adapt to how you think, not vice versa</p>
            </div>
          </div>
          
          <div class="flex gap-4 min-h-[4.5rem]">
            <DecorativeEmoji emoji="🪜" class="text-2xl flex-shrink-0" />
            <div class="flex-1">
              <p class="font-semibold text-content dark:text-dark-content mb-1">Multiplying Expertise</p>
              <p class="text-content-muted dark:text-dark-content-muted">Expertise should multiply, not gatekeep</p>
            </div>
          </div>
          
          <div class="flex gap-4 min-h-[4.5rem]">
            <DecorativeEmoji emoji="🌍" class="text-2xl flex-shrink-0" />
            <div class="flex-1">
              <p class="font-semibold text-content dark:text-dark-content mb-1">Universal Computation</p>
              <p class="text-content-muted dark:text-dark-content-muted">Every way of knowing deserves computational power</p>
            </div>
          </div>
          
          <div class="flex gap-4 min-h-[4.5rem]">
            <DecorativeEmoji emoji="🔍" class="text-2xl flex-shrink-0" />
            <div class="flex-1">
              <p class="font-semibold text-content dark:text-dark-content mb-1">Transparent AI</p>
              <p class="text-content-muted dark:text-dark-content-muted">AI should show its work (<a href="/definitions/glass-box" class="text-primary-dark dark:text-primary-light hover:text-primary">glass box</a>, not black box)</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Social Proof -->
    <section class="text-center space-y-6 py-8" aria-labelledby="credentials-heading">
      <Heading level={2} class="text-h3 font-bold text-content dark:text-dark-content" id="credentials-heading">
        What I've Built
      </Heading>
      
      <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <div class="p-6 bg-surface dark:bg-dark-surface rounded-xl">
          <p class="text-small text-content-subtle dark:text-dark-content-subtle mb-2">Innovation</p>
          <p class="font-bold text-content dark:text-dark-content">Inventor of axe Assistant</p>
          <p class="text-small text-content-muted dark:text-dark-content-muted mt-1">Deque Systems</p>
        </div>
        
        <div class="p-6 bg-surface dark:bg-dark-surface rounded-xl">
          <p class="text-small text-content-subtle dark:text-dark-content-subtle mb-2">Framework</p>
          <p class="font-bold text-content dark:text-dark-content">Building Ladders</p>
          <p class="text-small text-content-muted dark:text-dark-content-muted mt-1">Philosophy & Practice</p>
        </div>
        
        <div class="p-6 bg-surface dark:bg-dark-surface rounded-xl">
          <p class="text-small text-content-subtle dark:text-dark-content-subtle mb-2">Approach</p>
          <p class="font-bold text-content dark:text-dark-content">Pattern Creation</p>
          <p class="text-small text-content-muted dark:text-dark-content-muted mt-1">Reusable Expertise</p>
        </div>
      </div>
    </section>

    <!-- Value Proposition - COMMENTED OUT UNTIL SOLO DEV -->
    {/* <section class="text-center space-y-6 py-12 px-6 bg-gradient-to-r from-primary/5 to-secondary/5 dark:from-primary/10 dark:to-secondary/10 rounded-2xl" aria-labelledby="value-heading">
      <Heading level={2} class="text-h2 font-bold text-content dark:text-dark-content" id="value-heading">
        For Organizations
      </Heading>
      
      <p class="text-xl font-medium text-content dark:text-dark-content max-w-3xl mx-auto">
        I help organizations turn their best people's expertise into ladders everyone can climb
      </p>
      
      <div class="grid md:grid-cols-3 gap-4 max-w-4xl mx-auto text-left">
        <div class="flex items-start gap-3">
          <span class="text-2xl">🔄</span>
          <div>
            <p class="font-medium text-content dark:text-dark-content">Your senior engineer's debugging process</p>
            <p class="text-small text-content-muted dark:text-dark-content-muted">→ Available to every developer</p>
          </div>
        </div>
        
        <div class="flex items-start gap-3">
          <span class="text-2xl">🎯</span>
          <div>
            <p class="font-medium text-content dark:text-dark-content">Your accessibility expert's knowledge</p>
            <p class="text-small text-content-muted dark:text-dark-content-muted">→ Embedded in every design decision</p>
          </div>
        </div>
        
        <div class="flex items-start gap-3">
          <span class="text-2xl">🚀</span>
          <div>
            <p class="font-medium text-content dark:text-dark-content">Your domain expertise</p>
            <p class="text-small text-content-muted dark:text-dark-content-muted">→ Scalable competitive advantage</p>
          </div>
        </div>
      </div>
    </section> */}

    <!-- Content Navigation -->
    <section aria-labelledby="explore-heading">
      <Heading level={2} class="text-h2 font-bold mb-lg text-center">
        Explore
      </Heading>
      
      <div class="grid md:grid-cols-2 gap-6 max-w-4xl">
        {contentAreas.map((area) => (
          <Card
            title={area.title}
            body={area.body}
            href={area.href}
            headingLevel={3}
          />
        ))}
      </div>
    </section>

    <!-- Quick Connect -->
    <section class="text-center space-y-6" aria-labelledby="connect-heading">
      <Heading level={2} class="text-h2 font-bold">
        Stay Connected
      </Heading>
      
      <div class="flex flex-wrap justify-center gap-6">
        <a 
          href="/rss.xml" 
          class="inline-flex items-center gap-2 px-4 py-2 bg-accent/10 dark:bg-accent/20 hover:bg-accent/20 dark:hover:bg-accent/30 rounded-lg transition-colors duration-200 focus-ring"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>RSS Feed</span>
          <span aria-hidden="true">↗</span>
        </a>
        
        <a 
          href="https://www.linkedin.com/in/dylan--isaac/" 
          class="inline-flex items-center gap-2 px-4 py-2 bg-secondary/10 dark:bg-secondary/20 hover:bg-secondary/20 dark:hover:bg-secondary/30 rounded-lg transition-colors duration-200 focus-ring"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>LinkedIn</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </main>
</Layout>