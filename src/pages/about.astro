---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import EmailCTA from '../components/EmailCTA.astro';
import Heading from '../components/Heading.astro';

const focusAreas = [
  {
    title: "AI + Accessibility",
    icon: "🤖",
    description: "Both AI and accessibility work in the same fundamental domain: translating meaning across different representations. Whether it's making visual information legible to screen readers or helping AI understand human intent, I specialize in preserving meaning as it moves between modalities. This isn't about compliance—it's about ensuring ideas remain intact regardless of how they're perceived.",
    projects: ["axe Assistant", "Epistemological translation systems", "Adaptive interfaces"]
  },
  {
    title: "Systems & Automation",
    icon: "⚡",
    description: "Automation should be like a dishwasher for information work—handling the soulless drudgery so you can focus on what matters. I design transparent, human-in-the-loop systems that automate the mechanical connections between your ideas, not the ideas themselves. Think of it as having a calculator for prose or a Roomba for repetitive workflows: the tool handles the tedious parts while you retain control over everything meaningful.",
    projects: ["Glass-box workflows", "Human-in-the-loop systems", "Context automation"]
  },
  {
    title: "Semantic Understanding",
    icon: "🧠",
    description: "My accessibility work showed me the importance of explicit, machine-readable semantics—but creators don't always internalize these requirements. They have a vision, but struggle to express it in the formal structures needed for inclusion. I see AI's opportunity as the translator between what creators envision and the necessary semantics that make their work accessible to all. It's about bridging the gap between human intent and machine understanding.",
    projects: ["Intent-to-semantic translation", "Vision preservation systems", "Structured prompt patterns"]
  }
];
---

<Layout 
  title="About | Dylan Isaac"
  description="AI engineer and translator between worlds. I help organizations encode decades of siloed expertise into scalable patterns, transforming one expert's knowledge into ladders thousands can climb."
>
  <Header />
  <main id="main" class="max-w-content-wide mx-auto px-6 md:px-8 py-16" tabindex="-1">
    <div class="max-w-content">
      <!-- Personal Introduction -->
      <section class="mb-16" aria-labelledby="personal-intro-heading">
        <Heading level={1} class="text-4xl md:text-5xl font-bold mb-6 text-content dark:text-dark-content" id="personal-intro-heading">
          Hi, I'm Dylan
        </Heading>
        <div class="prose prose-xl text-content-muted dark:text-dark-content-muted space-y-4">
          <p>
            <strong class="text-content dark:text-dark-content">I'm a translator between worlds</strong>. Whether as a full-stack developer, 
            accessibility coach, or AI engineer, I help different ways of knowing speak to each other. For organizations, 
            this means transforming decades of siloed expertise into scalable patterns—one expert's knowledge becomes a ladder thousands can climb.
          </p>
          <p>
            I call this <a href="/definitions/building-ladders" class="font-medium text-primary-dark dark:text-primary-light hover:text-primary">building ladders</a>—creating 
            ways for people to climb to expertise that was previously out of reach. Unlike bridges that assume you can already walk their path, 
            ladders meet you at your current understanding and let you climb, rung by rung, to heights you couldn't access before. Now as an AI engineer, 
            I build these ladders by encoding your organization's unique expertise into patterns that adapt to each person's way of knowing.
          </p>
        </div>
      </section>

      <!-- Focus Areas -->
      <section class="mb-16" aria-labelledby="focus-areas-heading">
        <Heading level={2} class="text-3xl font-bold mb-8 text-content dark:text-dark-content" id="focus-areas-heading">What I Focus On</Heading>
        <div class="space-y-8">
          {focusAreas.map(({ title, icon, description, projects }, index) => (
            <article class="group bg-surface dark:bg-dark-surface rounded-xl p-8 border-b-4 border-transparent hover:border-accent-yellow focus-within:border-accent-yellow transition-[background-color,border-color] duration-200">
              <div class="flex items-start gap-6">
                <span class="text-4xl flex-shrink-0" role="img" aria-label={`${title} icon`}>
                  {icon}
                </span>
                <div class="flex-1">
                  <Heading level={3} class="text-2xl font-bold mb-3 text-content dark:text-dark-content group-hover:text-primary dark:group-hover:text-primary-light transition-colors" id={`focus-area-${index}`}>
                    {title}
                  </Heading>
                  <p class="text-content-muted dark:text-dark-content-muted mb-4">
                    {description}
                  </p>
                  <div class="flex flex-wrap gap-2" aria-label="Example projects">
                    {projects.map(project => (
                      <span class="text-small px-3 py-1 bg-surface/50 dark:bg-dark-surface/50 rounded-full text-content-subtle dark:text-dark-content-subtle">
                        {project}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- How I Work - COMMENTED OUT UNTIL READY -->
      {/* <section class="mb-16" aria-labelledby="how-i-work-heading">
        <Heading level={2} class="text-3xl font-bold mb-8 text-content dark:text-dark-content" id="how-i-work-heading">How I Work With Organizations</Heading>
        <div class="prose prose-lg text-content-muted dark:text-dark-content-muted space-y-4">
          <p>
            I partner with organizations in whatever way serves your needs best. Whether you need strategic guidance, 
            hands-on implementation, or team enablement, my focus remains the same: ensuring your AI systems amplify human 
            expertise rather than replace it.
          </p>
          <p>
            <strong class="text-content dark:text-dark-content">Ways we might work together:</strong>
          </p>
          <ul class="space-y-2">
            <li><strong class="text-content dark:text-dark-content">Pattern Creation:</strong> I embed with your experts to capture their decision-making process and encode it into reusable AI patterns that scale across your organization.</li>
            <li><strong class="text-content dark:text-dark-content">Workshops & Training:</strong> Teaching your teams to build human-centered AI systems, design effective LLM architectures, and create their own expertise patterns.</li>
            <li><strong class="text-content dark:text-dark-content">Project Consulting:</strong> Hands-on help with specific AI initiatives, from accessibility automation to knowledge management systems.</li>
            <li><strong class="text-content dark:text-dark-content">Prompt Engineering:</strong> Coaching your team to effectively translate their expertise into AI-ready patterns and prompts.</li>
          </ul>
          <p>
            The constant thread: I help you build AI that adapts to your people's ways of knowing, not the other way around. 
            Your unique expertise becomes a competitive advantage that scales indefinitely.
          </p>
        </div>
      </section> */}

      <!-- Current Work -->
      <section class="mb-16 p-8 bg-gradient-to-r from-primary/5 to-secondary/5 dark:from-primary/10 dark:to-secondary/10 rounded-2xl" aria-labelledby="current-work-heading">
        <Heading level={2} class="text-3xl font-bold mb-6 text-content dark:text-dark-content" id="current-work-heading">What I'm Building</Heading>
        <div class="prose prose-lg text-content-muted dark:text-dark-content-muted">
          <p>
            I'm the inventor of <a href="/projects#axe-assistant" class="font-medium text-primary-dark dark:text-primary-light hover:text-primary dark:hover:text-primary-light">axe Assistant</a>—a RAG-based AI 
            that utilizes the unparalleled domain knowledge of Deque Systems to help enterprise product organizations get customized 
            accessibility support on demand. <strong class="text-content dark:text-dark-content">It answers 500+ accessibility questions daily</strong>, 
            adapting existing knowledge to the personal context of developers, designers, and product owners when they need it.
          </p>
        </div>
      </section>

      <!-- Contact Section -->
      <section class="bg-surface dark:bg-dark-surface rounded-2xl p-8 md:p-12" aria-labelledby="contact-heading">
        <Heading level={2} class="text-3xl font-bold mb-6 text-content dark:text-dark-content" id="contact-heading">Let's Connect</Heading>
        <p class="text-lg mb-8 text-content-muted dark:text-dark-content-muted">
          I love conversations about accessibility, AI, epistemology, and education as empowerment. 
          Whether you're working on similar problems or just want to chat about making technology 
          more human, I'd love to hear from you.
        </p>
        <EmailCTA email="hey@dylanisa.ac" />
      </section>
    </div>
  </main>
</Layout>

<style>
  /* Simple hover effects */
  .group {
    transition: transform 0.2s ease;
  }
  
  .group:hover {
    transform: translateY(-2px);
  }
</style>