---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import EmailCTA from '../components/EmailCTA.astro';
import Heading from '../components/Heading.astro';

const focusAreas = [
  {
    title: "AI + Accessibility",
    icon: "🤖",
    description: "I bridge the gap between human needs and digital experiences, creating AI systems that adapt to people rather than forcing people to adapt to them. My work focuses on making technology truly accessible—not just compliant—by understanding different ways of knowing and translating between them.",
    projects: ["axe Assistant (RAG-based accessibility expert)", "Accessibility remediation tools", "Adaptive interfaces"]
  },
  {
    title: "Systems & Automation",
    icon: "⚡",
    description: "Every problem exists within interconnected systems. I design frameworks that automate repetitive tasks while preserving human agency, freeing up time and attention for what matters most. My approach balances modularity with adaptability to create sustainable solutions.",
    projects: ["Workflow automation", "Knowledge management systems", "Process optimization"]
  },
  {
    title: "Semantic Understanding",
    icon: "🧠",
    description: "Language is more than words—it's how we encode meaning and perspective. I build systems that capture and convey complex ideas, making knowledge more accessible and actionable through semantic analysis, information architecture, and thoughtful prompt engineering.",
    projects: ["LLM integration", "Information architecture", "Prompt design patterns"]
  }
];
---

<Layout title="About | Dylan Isaac">
  <Header />
  <main id="main" class="max-w-content-wide mx-auto px-6 md:px-8 py-16" tabindex="-1">
    <div class="max-w-content">
      <!-- Personal Introduction -->
      <section class="mb-16" aria-labelledby="personal-intro-heading">
        <Heading level={1} class="text-4xl md:text-5xl font-bold mb-6 text-content dark:text-dark-content" id="personal-intro-heading">
          Hi, I'm Dylan
        </Heading>
        <div class="prose prose-xl text-content-muted dark:text-dark-content-muted space-y-4">
          <p>
            I spent years doing what seemed like completely different jobs—full-stack developer, accessibility coach, 
            AI engineer—before I realized I'd been doing the same job all along: <strong class="text-content dark:text-dark-content">I've always been a translator between worlds</strong>.
          </p>
          <p>
            As an accessibility coach, I embedded myself in product teams. Not to enforce rules, but to translate. 
            I'd sit with designers who understood visual hierarchy perfectly but had never considered how that hierarchy 
            translates to someone navigating by keyboard. I'd work with developers who could optimize React hooks but 
            had never thought about how their loading states affect screen reader users.
          </p>
          <p>
            My job wasn't just teaching accessibility—it was translating one world's logic into another's language. 
            Now as an AI engineer, I build the translators themselves—giving everyone the ability to approach domains 
            that were previously opaque to them. I call this <a href="/definitions/building-ladders" class="font-medium text-primary-dark dark:text-primary-light hover:text-primary">building ladders</a>.
          </p>
        </div>
      </section>

      <!-- Focus Areas -->
      <section class="mb-16" aria-labelledby="focus-areas-heading">
        <Heading level={2} class="text-3xl font-bold mb-8 text-content dark:text-dark-content" id="focus-areas-heading">What I Focus On</Heading>
        <div class="space-y-8">
          {focusAreas.map(({ title, icon, description, projects }, index) => (
            <article class="group bg-surface dark:bg-dark-surface rounded-xl p-8 border-b-4 border-transparent hover:border-accent-yellow focus-within:border-accent-yellow transition-[background-color,border-color] duration-200">
              <div class="flex items-start gap-6">
                <span class="text-4xl flex-shrink-0" role="img" aria-label={`${title} icon`}>
                  {icon}
                </span>
                <div class="flex-1">
                  <Heading level={3} class="text-2xl font-bold mb-3 text-content dark:text-dark-content group-hover:text-primary dark:group-hover:text-primary-light transition-colors" id={`focus-area-${index}`}>
                    {title}
                  </Heading>
                  <p class="text-content-muted dark:text-dark-content-muted mb-4">
                    {description}
                  </p>
                  <div class="flex flex-wrap gap-2" aria-label="Example projects">
                    {projects.map(project => (
                      <span class="text-small px-3 py-1 bg-surface/50 dark:bg-dark-surface/50 rounded-full text-content-subtle dark:text-dark-content-subtle">
                        {project}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Current Work -->
      <section class="mb-16 p-8 bg-gradient-to-r from-primary/5 to-secondary/5 dark:from-primary/10 dark:to-secondary/10 rounded-2xl" aria-labelledby="current-work-heading">
        <Heading level={2} class="text-3xl font-bold mb-6 text-content dark:text-dark-content" id="current-work-heading">What I'm Building</Heading>
        <div class="prose prose-lg text-content-muted dark:text-dark-content-muted">
          <p>
            I recently created <a href="/projects#axe-assistant" class="font-medium text-primary-dark dark:text-primary-light hover:text-primary dark:hover:text-primary-light">axe Assistant</a>—a RAG-based AI 
            that makes accessibility expertise available 24/7. While working with teams at Deque Systems, I saw how 
            knowledge gets siloed. So I built a system that captures and translates decades of accessibility expertise 
            into guidance anyone can understand and act on.
          </p>
          <p>
            But axe Assistant is just one example of <a href="/definitions/building-ladders" class="font-medium text-primary-dark dark:text-primary-light hover:text-primary dark:hover:text-primary-light">building ladders</a>. 
            I'm exploring how we can encode expert thinking into reusable patterns—whether that's accessibility knowledge, 
            security analysis, or creative workflows. The goal isn't to replace experts, but to multiply their impact 
            by creating bridges others can climb.
          </p>
        </div>
      </section>

      <!-- Contact Section -->
      <section class="bg-surface dark:bg-dark-surface rounded-2xl p-8 md:p-12" aria-labelledby="contact-heading">
        <Heading level={2} class="text-3xl font-bold mb-6 text-content dark:text-dark-content" id="contact-heading">Let's Connect</Heading>
        <p class="text-lg mb-8 text-content-muted dark:text-dark-content-muted">
          I'm always interested in conversations about accessibility, AI, and building 
          technology that amplifies human potential. Whether you're working on something 
          similar or just want to chat about these ideas, I'd love to hear from you.
        </p>
        <EmailCTA email="hey@dylanisa.ac" />
      </section>
    </div>
  </main>
</Layout>

<style>
  /* Simple hover effects */
  .group {
    transition: transform 0.2s ease;
  }
  
  .group:hover {
    transform: translateY(-2px);
  }
</style>