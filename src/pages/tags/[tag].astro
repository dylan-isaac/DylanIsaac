---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Tag from '../../components/Tag.astro';
import Heading from '../../components/Heading.astro';
import ArrowLink from '../../components/ArrowLink.astro';
import { getAllTagsWithContent, getPostsByTag, getDefinitionsByTag, getRelatedTags, slugifyTag, normalizeTag } from '../../utils/tags';
import { format } from 'date-fns';

export async function getStaticPaths() {
  const tagContent = await getAllTagsWithContent();
  
  return Array.from(tagContent.keys()).map(tag => ({
    params: { tag: slugifyTag(tag) },
    props: { originalTag: tag }
  }));
}

const { tag } = Astro.params;
const { originalTag } = Astro.props;

const posts = await getPostsByTag(originalTag);
const definitions = await getDefinitionsByTag(originalTag);
const relatedTags = await getRelatedTags(originalTag);
const allTagsWithContent = await getAllTagsWithContent();
const currentTagIndex = Array.from(allTagsWithContent.keys()).indexOf(originalTag);

const totalCount = posts.length + definitions.length;
---

<Layout 
  title={`${originalTag} | Dylan Isaac`}
  description={`Articles, definitions, and resources about ${originalTag.toLowerCase()}. Explore thoughts on ${originalTag.toLowerCase()} and related topics.`}
>
  <Header />
  <main id="main" class="max-w-content-wide mx-auto px-6 md:px-8 py-16">
    <div class="max-w-content">
      <div class="mb-16">
        <div class="flex items-center gap-4 mb-8">
          <ArrowLink href="/tags" class="text-base">
            ← All Topics
          </ArrowLink>
        </div>
        <div class="flex items-center gap-4">
          <Heading level={1} class="text-h1 font-bold">Content tagged with</Heading>
          <Tag name={originalTag} colorIndex={currentTagIndex} clickable={false} />
        </div>
        <p class="mt-4 text-content-muted dark:text-dark-content-muted">
          {totalCount} {totalCount === 1 ? 'item' : 'items'} found 
          ({posts.length} {posts.length === 1 ? 'article' : 'articles'}, 
          {definitions.length} {definitions.length === 1 ? 'definition' : 'definitions'})
        </p>
      </div>
      
      {posts.length > 0 && (
        <section id="tagged-posts" class="mb-16">
          <Heading level={2} class="text-h2 font-bold mb-8">Articles</Heading>
          <div class="space-y-8">
            {posts.map(post => (
              <article class="group bg-surface dark:bg-dark-surface rounded-xl p-6 border-b-4 border-transparent hover:border-accent-yellow focus-within:border-accent-yellow transition-[background-color,border-color] duration-200">
                <a href={`/writing/${post.slug}`} class="block space-y-4">
                  <div class="flex items-center gap-3 text-small text-content-muted dark:text-dark-content-muted">
                    <time datetime={post.data.publishDate.toISOString()}>
                      {format(post.data.publishDate, 'MMMM d, yyyy')}
                    </time>
                  </div>
                  
                  <div class="space-y-3">
                    <Heading level={3} class="text-h3 font-bold group-hover:text-primary dark:group-hover:text-primary-light transition-colors">
                      {post.data.title}
                    </Heading>
                    {post.data.description && (
                      <p class="text-content-muted dark:text-dark-content-muted">
                        {post.data.description}
                      </p>
                    )}
                  </div>
                </a>
                
                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-2 mt-4">
                    {post.data.tags.map((postTag) => (
                      <Tag 
                        name={postTag} 
                        colorIndex={Array.from(allTagsWithContent.keys()).indexOf(postTag)} 
                      />
                    ))}
                  </div>
                )}
              </article>
            ))}
          </div>
        </section>
      )}
      
      {definitions.length > 0 && (
        <section id="tagged-definitions">
          <Heading level={2} class="text-h2 font-bold mb-8">Definitions</Heading>
          <div class="grid gap-6 md:grid-cols-2">
            {definitions.map(def => (
              <a 
                href={`/definitions/${def.slug}`}
                class="group block p-6 bg-surface dark:bg-dark-surface rounded-xl border-b-4 border-transparent hover:border-accent-yellow focus:border-accent-yellow transition-[background-color,border-color] duration-200"
              >
                <h3 class="text-h4 font-bold mb-3 text-content dark:text-dark-content group-hover:text-primary dark:group-hover:text-primary-light transition-colors">
                  {def.data.term}
                </h3>
                <p class="text-content-muted dark:text-dark-content-muted text-sm">
                  {def.data.definition}
                </p>
              </a>
            ))}
          </div>
        </section>
      )}

      {relatedTags.size > 0 && (
        <aside class="mt-16 pt-16 border-t border-content-subtle/20 dark:border-dark-content-subtle/20">
          <Heading level={2} class="text-h3 font-medium mb-8">Related Topics</Heading>
          <div class="flex flex-wrap gap-3">
            {Array.from(relatedTags.entries()).map(([relatedTag, count]) => (
              <div class="inline-flex items-center gap-2">
                <Tag 
                  name={relatedTag} 
                  colorIndex={Array.from(allTagsWithContent.keys()).indexOf(relatedTag)} 
                />
                <span class="text-small text-content-muted dark:text-dark-content-muted">
                  ({count})
                </span>
              </div>
            ))}
          </div>
        </aside>
      )}
    </div>
  </main>
</Layout>