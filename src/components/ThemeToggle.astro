<script>
  const themeToggle = document.getElementById('theme-toggle');
  
  // Check for saved theme or system preference
  const getPreferredTheme = () => {
    const saved = localStorage.getItem('theme');
    if (saved) return saved;
    
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  };

  // Apply theme and update button attributes
  const setTheme = (theme) => {
    document.documentElement.classList.toggle('dark', theme === 'dark');
    localStorage.setItem('theme', theme);
    
    // Update button accessibility attributes
    if (themeToggle) {
      themeToggle.setAttribute('aria-label', `Switch to ${theme === 'dark' ? 'light' : 'dark'} theme`);
      themeToggle.setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
      
      // Announce theme change to screen readers
      const announcement = document.getElementById('theme-announcement');
      if (announcement) {
        announcement.textContent = `Theme changed to ${theme} mode`;
        // Clear announcement after a delay
        setTimeout(() => {
          announcement.textContent = '';
        }, 1000);
      }
    }
  };

  // Initial theme setup
  setTheme(getPreferredTheme());

  // Handle toggle click
  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.contains('dark');
    setTheme(isDark ? 'light' : 'dark');
  });
  
  // Handle keyboard shortcuts (T key for theme toggle)
  document.addEventListener('keydown', (e) => {
    // Only handle shortcuts when not typing in input fields
    if (e.target?.tagName === 'INPUT' || e.target?.tagName === 'TEXTAREA') {
      return;
    }
    
    // Shift + T to toggle theme (avoid conflict with regular typing)
    if (e.shiftKey && e.key.toLowerCase() === 't') {
      e.preventDefault();
      const isDark = document.documentElement.classList.contains('dark');
      setTheme(isDark ? 'light' : 'dark');
      themeToggle?.focus(); // Focus the button so user knows what happened
    }
  });

  // Listen for system theme changes
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    if (!localStorage.getItem('theme')) {
      setTheme(e.matches ? 'dark' : 'light');
    }
  });
</script>

<button 
  id="theme-toggle"
  type="button"
  aria-label="Switch to dark theme"
  aria-pressed="false"
  title="Toggle between light and dark theme (Shift+T)"
  class="p-2 hover:bg-surface-secondary dark:hover:bg-dark-surface-secondary rounded-full transition-colors duration-200 focus-ring"
>
  <span class="dark:hidden" aria-hidden="true">🌙</span>
  <span class="hidden dark:inline" aria-hidden="true">☀️</span>
  <span class="sr-only">Toggle theme</span>
</button>

<!-- Screen reader announcements -->
<div aria-live="polite" aria-atomic="true" class="sr-only" id="theme-announcement"></div> 