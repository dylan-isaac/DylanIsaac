---
import ThemeToggle from './ThemeToggle.astro';
import TableOfContents from './TableOfContents.astro';

const navItems = [
  { href: "/about", label: "About", dotColor: "bg-primary" },
  { href: "/writing", label: "Writing", dotColor: "bg-accent" },
  { href: "/projects", label: "Projects", dotColor: "bg-secondary" },
  { href: "/resources", label: "Resources", dotColor: "bg-primary" },
];
---

<a 
  href="#main" 
  id="skip-link"
  class="sr-only focus:not-sr-only fixed top-4 left-4 bg-accent px-4 py-2 rounded-md z-50 focus-ring-strong no-underline-link text-content font-medium"
>
  Skip to main content
</a>

<div id="header-wrapper" class="sticky top-0 z-40 bg-surface dark:bg-dark-surface transition-colors duration-200">
  <header class="border-b border-accent-yellow dark:border-accent-yellow">
    <div id="header-content" class="max-w-4xl mx-auto px-6 md:px-8 transition-[padding] duration-200" style="padding-top: 20px; padding-bottom: 20px;">
      <div class="flex justify-between items-center">
        <a 
          href="/" 
          id="logo-text"
          class="text-h3 font-medium hover:text-primary dark:hover:text-primary-light transition-colors duration-200 no-underline-link"
        >
          dylan isaac
        </a>
        
        <!-- Desktop/Tablet Navigation -->
        <nav class="hidden md:flex items-center gap-6 mr-8">
          {navItems.map((item, index) => (
            <>
              <a 
                href={item.href} 
                class="hover:text-primary dark:hover:text-primary-light transition-colors duration-200 no-underline-link"
                aria-current={Astro.url.pathname === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
              {index < navItems.length - 1 && (
                <span 
                  class={`w-1.5 h-1.5 rounded-full ${item.dotColor}`} 
                  aria-hidden="true"
                ></span>
              )}
            </>
          ))}
        </nav>

        <div class="flex items-center gap-4">
          <ThemeToggle />
          <button 
            id="menu-toggle"
            type="button"
            aria-label="Open navigation menu and table of contents"
            aria-expanded="false"
            aria-controls="toc-sidebar"
            class="flex flex-col gap-1.5 p-2 hover:bg-surface-secondary dark:hover:bg-dark-surface-secondary rounded-lg transition-colors duration-200 focus-ring"
          >
            <span class="w-5 h-0.5 bg-primary" aria-hidden="true"></span>
            <span class="w-5 h-0.5 bg-secondary" aria-hidden="true"></span>
            <span class="w-5 h-0.5 bg-accent" aria-hidden="true"></span>
            <span class="sr-only" id="menu-status">Menu is closed</span>
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- Table of Contents Sidebar -->
  <div 
    id="toc-sidebar"
    role="dialog"
    aria-modal="false"
    aria-labelledby="toc-heading"
    aria-describedby="toc-description"
    class="fixed right-0 top-[81px] bottom-0 w-64 bg-surface dark:bg-dark-surface transform translate-x-full overflow-y-auto transition-[transform,background-color] duration-200 border-l border-surface-secondary dark:border-dark-surface-secondary"
    tabindex="-1"
  >
    <div class="sr-only" id="toc-description">Navigation menu and table of contents. Press Escape to close.</div>
    <div class="p-6">
      <!-- Close button for keyboard users -->
      <button 
        id="sidebar-close"
        type="button"
        aria-label="Close navigation menu"
        class="md:hidden mb-4 p-2 -ml-2 hover:bg-surface-secondary dark:hover:bg-dark-surface-secondary rounded-lg transition-colors duration-200 focus-ring"
      >
        <span class="sr-only">Close menu</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      
      <!-- Mobile-only Navigation -->
      <nav class="md:hidden space-y-8 mb-8" aria-label="Main navigation">
        <ul class="space-y-4">
          {navItems.map((item) => (
            <li>
              <a 
                href={item.href} 
                class="block hover:text-accent transition-colors duration-200 no-underline-link focus-ring rounded px-2 py-1 -mx-2"
                aria-current={Astro.url.pathname === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Table of Contents -->
      <nav aria-labelledby="toc-heading">
        <TableOfContents />
      </nav>
    </div>
  </div>
  
  <!-- Screen reader announcements -->
  <div aria-live="polite" aria-atomic="true" class="sr-only" id="sidebar-announcements"></div>
</div>

<script>
  const menuToggle = document.getElementById('menu-toggle') as HTMLButtonElement | null;
  const tocSidebar = document.getElementById('toc-sidebar') as HTMLElement | null;
  const headerContent = document.getElementById('header-content') as HTMLElement | null;
  const logoText = document.getElementById('logo-text') as HTMLElement | null;
  const sidebarClose = document.getElementById('sidebar-close') as HTMLButtonElement | null;
  const menuStatus = document.getElementById('menu-status') as HTMLElement | null;
  const announcements = document.getElementById('sidebar-announcements') as HTMLElement | null;
  
  // Focus management variables
  let lastFocusedElement: HTMLElement | null = null;
  let focusableElements: HTMLElement[] = [];
  
  // Function to check if there's enough room for the menu AND content
  const hasEnoughRoom = () => window.innerWidth >= 1216;
  
  // Screen reader announcement helper
  const announceToScreenReader = (message: string) => {
    if (announcements) {
      announcements.textContent = message;
      // Clear after announcement to avoid repetition
      setTimeout(() => {
        announcements.textContent = '';
      }, 1000);
    }
  };
  
  // Get all focusable elements in sidebar
  const getFocusableElements = (): HTMLElement[] => {
    if (!tocSidebar) return [];
    const selectors = 'a, button, [tabindex]:not([tabindex="-1"])';
    const nodes = tocSidebar.querySelectorAll<HTMLElement>(selectors);
    return Array.from(nodes).filter(
      (el) => el instanceof HTMLElement && !el.hasAttribute('disabled') && !el.getAttribute('aria-hidden')
    );
  };
  
  // Focus trap for sidebar
  const trapFocus = (e: KeyboardEvent) => {
    if (e.key !== 'Tab') return;
    
    const focusable = getFocusableElements();
    const firstFocusable = focusable[0];
    const lastFocusable = focusable[focusable.length - 1];
    
    if (e.shiftKey) {
      // Shift + Tab
      if (document.activeElement === firstFocusable) {
        e.preventDefault();
        lastFocusable?.focus();
      }
    } else {
      // Tab
      if (document.activeElement === lastFocusable) {
        e.preventDefault();
        firstFocusable?.focus();
      }
    }
  };
  
  // Handle escape key
  const handleEscape = (e: KeyboardEvent) => {
    if (e.key === 'Escape') {
      const isExpanded = menuToggle?.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeSidebar();
      }
    }
  };
  
  // Close sidebar function
  const closeSidebar = () => {
    applyState(false);
    saveState(false);
    announceToScreenReader('Navigation menu closed');
    
    // Return focus to menu toggle
    if (lastFocusedElement && lastFocusedElement.focus) {
      lastFocusedElement.focus();
    } else {
      menuToggle?.focus();
    }
    
    // Remove event listeners
    document.removeEventListener('keydown', trapFocus);
    document.removeEventListener('keydown', handleEscape);
  };
  
  // Open sidebar function  
  const openSidebar = () => {
    // Store the currently focused element
    lastFocusedElement = document.activeElement as HTMLElement | null;
    
    applyState(true);
    saveState(true);
    announceToScreenReader('Navigation menu opened');
    
    // Focus the first focusable element in sidebar after transition
    setTimeout(() => {
      const focusable = getFocusableElements();
      if (focusable.length > 0) {
        focusable[0].focus();
      } else {
        tocSidebar?.focus();
      }
    }, 250);
    
    // Add event listeners for focus trap and escape
    document.addEventListener('keydown', trapFocus);
    document.addEventListener('keydown', handleEscape);
  };
  
  // Handle header shrinking on scroll
  const handleScroll = () => {
    const scrollY = window.scrollY;
    const isScrolled = scrollY > 100;
    const headerWrapper = document.getElementById('header-wrapper');
    const header = headerWrapper?.querySelector('header') as HTMLElement | null;
    
    // Toggle a single class on document body for cleaner CSS control
    if (isScrolled) {
      document.body.classList.add('header-scrolled');
      // Remove explicit height to let padding control it
      if (header) {
        header.style.transition = 'all 200ms ease';
      }
      // Apply smaller padding when scrolled
      if (headerContent) {
        headerContent.style.paddingTop = '12px';
        headerContent.style.paddingBottom = '12px';
      }
      // Don't change text size to avoid diagonal shrinking
      if (tocSidebar) {
        tocSidebar.style.top = '65px'; // Match new smaller header
      }
      headerWrapper?.classList.add('shadow-md');
    } else {
      document.body.classList.remove('header-scrolled');
      // Keep header height auto
      headerContent?.classList.remove('py-1');
      // Re-apply original padding
      if (headerContent) {
        headerContent.style.paddingTop = '20px';
        headerContent.style.paddingBottom = '20px';
      }
      // Text size stays the same
      if (tocSidebar) {
        tocSidebar.style.top = '81px';
      }
      headerWrapper?.classList.remove('shadow-md');
    }
  };
  
  // Initial check on load
  handleScroll();
  
  // Add scroll listener with throttling
  let scrollTimeout: number;
  window.addEventListener('scroll', () => {
    if (scrollTimeout) {
      window.cancelAnimationFrame(scrollTimeout);
    }
    scrollTimeout = window.requestAnimationFrame(() => {
      handleScroll();
    });
  }, { passive: true });
  
  // Storage key for sidebar state
  const SIDEBAR_STATE_KEY = 'tocSidebarExpanded';
  
  // Check if we're on desktop (only save/load state on desktop)
  const isDesktop = () => window.innerWidth >= 1024; // md breakpoint and up
  
  // Get saved state from localStorage (only on desktop)
  const getSavedState = () => {
    // Don't use saved state on mobile/tablet
    if (!isDesktop()) {
      return false; // Always collapsed on mobile/tablet
    }
    
    const saved = localStorage.getItem(SIDEBAR_STATE_KEY);
    if (saved !== null) {
      return saved === 'true';
    }
    // Default to collapsed on desktop
    return false;
  };
  
  // Save state to localStorage (only on desktop)
  const saveState = (isExpanded: boolean) => {
    // Only save state on desktop
    if (isDesktop()) {
      localStorage.setItem(SIDEBAR_STATE_KEY, isExpanded.toString());
    }
  };
  
  // Apply state to UI
  const applyState = (isExpanded: boolean, skipAnimation = false) => {
    menuToggle?.setAttribute('aria-expanded', isExpanded.toString());
    menuToggle?.setAttribute('aria-label', isExpanded ? 'Close navigation menu' : 'Open navigation menu and table of contents');
    
    // Update menu status for screen readers
    if (menuStatus) {
      menuStatus.textContent = isExpanded ? 'Menu is open' : 'Menu is closed';
    }
    
    
    if (skipAnimation) {
      tocSidebar?.classList.toggle('translate-x-full', !isExpanded);
    } else {
      // Use setTimeout to ensure transition happens
      requestAnimationFrame(() => {
        tocSidebar?.classList.toggle('translate-x-full', !isExpanded);
      });
    }
  };

  // Set initial state
  const initialState = getSavedState();
  applyState(initialState, true); // Skip animation on initial load

  // Add transition class after initial state is set
  window.addEventListener('load', () => {
    tocSidebar?.classList.add('transition-transform', 'duration-200', 'ease-in-out');
  });

  // Toggle menu on button click
  menuToggle?.addEventListener('click', () => {
    const isExpanded = menuToggle?.getAttribute('aria-expanded') === 'true';
    if (isExpanded) {
      closeSidebar();
    } else {
      openSidebar();
    }
  });
  
  // Close button event listener
  sidebarClose?.addEventListener('click', closeSidebar);
  
  // Keyboard shortcuts
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    // Only handle shortcuts when not typing in input fields
    const target = e.target as Element | null;
    if (target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA')) {
      return;
    }
    
    // Alt/Option + M to toggle menu (common pattern)
    if (e.altKey && e.key.toLowerCase() === 'm') {
      e.preventDefault();
      const isExpanded = menuToggle?.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeSidebar();
      } else {
        openSidebar();
      }
    }
  });

  // Handle resize events
  let previousWidth = window.innerWidth;
  window.addEventListener('resize', () => {
    const currentWidth = window.innerWidth;
    const wasDesktop = previousWidth >= 1024;
    const nowDesktop = currentWidth >= 1024;
    
    // If we've moved from desktop to mobile/tablet
    if (wasDesktop && !nowDesktop) {
      // Always collapse on mobile/tablet
      closeSidebar();
      // Clear saved state when going to mobile
      localStorage.removeItem(SIDEBAR_STATE_KEY);
    } 
    // If we've moved from mobile/tablet to desktop
    else if (!wasDesktop && nowDesktop) {
      // Restore saved state or use default
      const savedState = getSavedState();
      applyState(savedState, true);
    }
    
    previousWidth = currentWidth;
  });

  // Enhanced skip link functionality
  const skipLink = document.getElementById('skip-link');
  skipLink?.addEventListener('click', (e) => {
    e.preventDefault();
    const mainContent = document.getElementById('main');
    if (mainContent) {
      // Ensure main content is focusable and focus it
      mainContent.setAttribute('tabindex', '-1');
      mainContent.focus();
      // Smooth scroll to main content
      mainContent.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });
</script>